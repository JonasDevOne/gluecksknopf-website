---
const { path = '' } = Astro.props;

const link = import.meta.env.BASE_URL + path;
---

<a href={link} class="inline-block">
  <h2
    class="mb-5 px-3 py-2 font-bold text-2xl border-2 border-current rounded-xl transition-all duration-200 hover:underline hover:scale-105 hover:translate-x-1 hover:-translate-y-1 hover:shadow-[-6px_6px_0px_0px_#85E1A8FF]"
  >
    <slot/>
  </h2>
</a>