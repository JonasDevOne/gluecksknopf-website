---
const { link } = Astro.props;
---

<a href={link} class="inline-block">
  <h2
    class="mb-5 px-3 py-2 font-bold text-2xl border-2 border-current transition-all duration-200 hover:underline hover:scale-105 hover:translate-x-1 hover:-translate-y-1 hover:shadow-[-6px_6px_0px_0px_currentColor]"
  >
    <slot/>
  </h2>
</a>