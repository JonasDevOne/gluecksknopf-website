---
// src/components/GalleryItem.astro
import ImageCard from "@/components/ImageCard.astro";
import ImageStack from "@/components/ImageStack.astro";

interface Props {
  item: any;
  isEager?: boolean;
  globalIndex?: number;
}

const { item, isEager = false, globalIndex } = Astro.props;
const isStack = "resolvedImages" in item;
---

{isStack ? (
<ImageStack stack={item} isEager={isEager} globalIndex={globalIndex} />
  ) : (
<ImageCard image={item} isEager={isEager} globalIndex={globalIndex} />
  )}