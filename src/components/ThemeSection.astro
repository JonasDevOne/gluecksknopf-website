---
import Section from "../layouts/Section.astro";
import LinkButton from "./LinkButton.astro";

import { getCollection } from 'astro:content';
import Card from './ThemeCard.astro';
import CarouselNew from "@/components/CarouselNew.astro";

const themen = await getCollection('themeCollection');
themen.sort((a, b) => a.data.order - b.data.order);
---

<Section label="Theme Section" class="max-w-[95vw] mx-auto my-5">
  <LinkButton link="/themen">Themenwelten</LinkButton>

  <CarouselNew/>

</Section>