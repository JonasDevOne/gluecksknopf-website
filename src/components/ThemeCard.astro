---
import { Image } from 'astro:assets';

const { img, alt, title = "Titel", text } = Astro.props;
---

<div aria-label="card" class="swiper-slide h-auto flex">
  <div class="bg-white rounded-2xl shadow-md hover:opacity-80 flex flex-col w-full overflow-hidden">
    <Image
        src={img}
        alt={alt}
        class="w-full aspect-video object-cover"
    />
    <div class="p-4 flex flex-col flex-1">
      <h3 class="text-base font-bold text-gray-900 mb-1">{title}</h3>
      <p class="text-gray-600 text-xs leading-relaxed">{text}</p>
    </div>
  </div>
</div>