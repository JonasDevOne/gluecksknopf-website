---
import { Image } from 'astro:assets';

const { img, alt, title = "Titel", text, id = "" } = Astro.props;
const anchor = id;
---

<div aria-label="card" class="swiper-slide h-auto flex">
  <a
    href={`${import.meta.env.BASE_URL}/themen#${anchor}`}
    class="group/card bg-white rounded-2xl shadow-md flex flex-col w-full overflow-hidden"
  >
    <div class="w-full aspect-video overflow-hidden bg-black">
      <Image
        src={img}
        alt={alt}
        class="w-full h-full object-contain transition-transform duration-300 group-hover/card:scale-105"
      />
    </div>
    <div class="p-4 flex flex-col flex-1">
      <h3 class="text-base font-bold mb-1">{title}</h3>
      <p class="text-gray-600 text-xs leading-relaxed">{text}</p>
    </div>
  </a>
</div>