---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/thumbs';
import 'swiper/css/free-mode';

interface ModalImage {
  title: string;
  themeTitle: string;
  themeId: string;
  src: string;
}

interface Props {
  allImages: ModalImage[];
}

const { allImages } = Astro.props;
---

<div
    id="theme-modal"
    style="display: none;"
    class="w-full bg-black/95 flex-col justify-between overflow-hidden rounded-xl max-h-[calc(100vh-9rem)]"
    aria-hidden="true"
>
  <!-- Modal Header -->
  <div class="flex items-center justify-between px-6 py-3 bg-neutral-900/90 border-b border-white/10 shrink-0 text-white z-10 min-h-14">
    <div class="flex flex-col justify-center min-h-9">
      <h3 id="modal-theme-title" class="text-sm md:text-base font-bold text-accent line-clamp-1"></h3>
      <p id="modal-image-title" class="text-xs text-slate-400 line-clamp-1 min-h-4"></p>
    </div>
    <button
        id="modal-close-btn"
        type="button"
        class="p-2 text-white/70 hover:text-white cursor-pointer transition-colors rounded-lg bg-white/10 hover:bg-white/20 shrink-0 ml-4"
        aria-label="Modal schließen"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Haupt-Swiper -->
  <div class="swiper main-swiper w-full flex-1 min-h-0 relative select-none bg-black">
    <div class="swiper-wrapper">
      {allImages.map((img) => (
          <div
              class="swiper-slide flex! items-center justify-center p-4 h-full w-full overflow-hidden"
              data-theme-id={img.themeId}
              data-theme-title={img.themeTitle}
              data-image-title={img.title}
          >
            <div class="relative w-full h-full flex items-center justify-center min-h-0 overflow-hidden">
              <img
                  src={img.src}
                  alt={img.title || "Galerie Bild"}
                  class="max-h-full max-w-full object-contain pointer-events-none select-none rounded-lg"
              />
            </div>
          </div>
      ))}
    </div>
    <div class="swiper-button-next text-white! after:text-xl!"></div>
    <div class="swiper-button-prev text-white! after:text-xl!"></div>
  </div>

  <!-- Thumbs-Swiper -->
  <div class="swiper thumbs-swiper w-full h-24 bg-neutral-950 p-3 shrink-0 select-none border-t border-white/10">
    <div class="swiper-wrapper flex items-center">
      {allImages.map((img) => (
          <div class="swiper-slide w-20! h-16! cursor-pointer rounded-md overflow-hidden shrink-0 border-2 border-transparent transition-all duration-200">
            <img
                src={img.src}
                alt={img.title || "Vorschau"}
                class="w-full h-full object-cover"
            />
          </div>
      ))}
    </div>
  </div>
</div>

<style>
  .thumbs-swiper .swiper-slide {
    opacity: 0.4;
  }
  .thumbs-swiper .swiper-slide:hover {
    opacity: 0.75;
  }
  .thumbs-swiper .swiper-slide-thumb-active {
    opacity: 1 !important;
    border-color: var(--color-accent, #3b82f6) !important;
    transform: scale(1.05);
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Thumbs, FreeMode } from 'swiper/modules';

  function initModalSwiper() {
    const modal = document.getElementById('theme-modal') as HTMLElement | null;
    const closeBtn = document.getElementById('modal-close-btn');
    const themeTitleEl = document.getElementById('modal-theme-title');
    const imageTitleEl = document.getElementById('modal-image-title');

    if (!modal) return;

    // Direct Elements (verhindert 'querySelectorAll is not a function' Fehler)
    const mainSwiperEl = modal.querySelector('.main-swiper') as HTMLElement | null;
    const thumbsSwiperEl = modal.querySelector('.thumbs-swiper') as HTMLElement | null;
    const nextEl = modal.querySelector('.swiper-button-next') as HTMLElement | null;
    const prevEl = modal.querySelector('.swiper-button-prev') as HTMLElement | null;

    if (!mainSwiperEl || !thumbsSwiperEl) return;

    // 1. Thumbs Swiper
    const thumbsSwiper = new Swiper(thumbsSwiperEl, {
      modules: [FreeMode],
      spaceBetween: 10,
      slidesPerView: 'auto',
      centerInsufficientSlides: true,
      centeredSlides: true,
      slideToClickedSlide: true,
      freeMode: true,
      watchSlidesProgress: true,
    });

    // 2. Haupt-Swiper
    const mainSwiper = new Swiper(mainSwiperEl, {
      modules: [Navigation, Thumbs],
      spaceBetween: 20,
      navigation: {
        nextEl: nextEl,
        prevEl: prevEl,
      },
      thumbs: {
        swiper: thumbsSwiper,
      },
      on: {
        slideChange: (swiper) => {
          updateHeaderInfo(swiper.activeIndex);
          thumbsSwiper.slideTo(swiper.activeIndex);
        },
      },
    });

    function updateHeaderInfo(index: number) {
      const activeSlide = mainSwiper.slides[index];
      if (activeSlide && themeTitleEl && imageTitleEl) {
        themeTitleEl.textContent = activeSlide.dataset.themeTitle || '';
        imageTitleEl.textContent = activeSlide.dataset.imageTitle || '';
      }
    }

    function openModal(index: number) {
      // 1. Galerie über eindeutige ID ausblenden
      const galleryEl = document.getElementById('theme-gallery-view');
      if (galleryEl) {
        galleryEl.style.display = 'none';
      }

      // 2. Modal als Flexbox einblenden
      modal!.style.display = 'flex';
      modal!.setAttribute('aria-hidden', 'false');

      // 3. Swiper neu berechnen & ausrichten
      mainSwiper.update();
      thumbsSwiper.update();

      mainSwiper.slideTo(index, 0);
      thumbsSwiper.slideTo(index, 0);
      updateHeaderInfo(index);
    }

    function closeModal() {
      // 1. Modal ausblenden
      modal!.style.display = 'none';
      modal!.setAttribute('aria-hidden', 'true');

      // 2. Galerie wieder einblenden
      const galleryEl = document.getElementById('theme-gallery-view');
      if (galleryEl) {
        galleryEl.style.display = '';
      }

      // 3. Zur gewählten Stelle scrollen
      const activeSlide = mainSwiper.slides[mainSwiper.activeIndex];
      if (activeSlide) {
        const themeId = activeSlide.dataset.themeId;
        if (themeId) {
          const detailsEl = document.getElementById(themeId) as HTMLDetailsElement | null;
          if (detailsEl) {
            detailsEl.open = true;
            detailsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const card = target.closest('.gallery-image-card') as HTMLElement;
      if (card && card.dataset.globalIndex !== undefined) {
        openModal(parseInt(card.dataset.globalIndex, 10));
        return;
      }

      const titleTrigger = target.closest('.theme-title-trigger') as HTMLElement;
      if (titleTrigger && titleTrigger.dataset.startIndex !== undefined) {
        openModal(parseInt(titleTrigger.dataset.startIndex, 10));
        return;
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal!.style.display !== 'none') {
        closeModal();
      }
    });
  }

  initModalSwiper();
  document.addEventListener('astro:page-load', initModalSwiper);
</script>