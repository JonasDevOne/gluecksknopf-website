---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/thumbs';
import 'swiper/css/free-mode';
import {Image} from "astro:assets";

interface ModalImage {
  title: string;
  description: string;
  themeTitle: string;
  themeId: string;
  img: any;
}

interface Props {
  allImages: ModalImage[];
}

const { allImages } = Astro.props;
---

<div
  id="theme-modal"
  style="display: none;"
  class="relative w-full h-full flex flex-col justify-between overflow-visible lg:overflow-hidden max-h-[calc(100vh-8rem)] rounded-2xl border border-slate-500 bg-white"
  aria-hidden="true"
>
  <button
    id="modal-close-btn"
    type="button"
    class="close-btn absolute top-0 -right-14 lg:top-3 lg:right-3 z-40 p-2.5 rounded-xl bg-slate-600 text-white hover:text-accent cursor-pointer transition-all duration-300 shadow-md border border-slate-200"
    aria-label="Modal schließen"
  >
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <!-- Hauptbereich: Flex-Layout mit 3 Spalten (Button Links | Swiper Mitte | Button Rechts) -->
  <div class="w-full flex-1 min-h-0 flex items-center justify-between gap-2 sm:gap-4 py-4 sm:py-6">

    <!-- 1. Feste Spalte Links: Button liegt außerhalb des Swipers -->
    <div class="shrink-0 flex items-center justify-center w-8 sm:w-10 h-full">
      <div class="swiper-button-prev static! top-auto! left-auto! right-auto! mt-0! text-slate-700! hover:text-accent! after:text-lg! sm:after:text-xl! cursor-pointer"></div>
    </div>

    <!-- 2. Mittlere Spalte: Haupt-Swiper -->
    <div class="swiper main-swiper flex-1 min-w-0 h-full relative select-none">
      <div class="swiper-wrapper">
        {allImages.map((img) => (
          <div
            class="swiper-slide flex! flex-col xl:flex-row items-center justify-center gap-4 xl:gap-8 h-full w-full min-w-0 min-h-0 overflow-hidden p-1 sm:p-2"
            data-theme-id={img.themeId}
            data-theme-title={img.themeTitle}
            data-image-title={img.title}
          >
            <!-- 16:9 Image Card Container -->
            <div class="relative flex-1 w-full h-full max-h-full min-w-0 min-h-0 flex items-center justify-center overflow-hidden">
              <!-- w-full h-auto unter 1280px (verhindert horizontales Überquellen), xl:h-full xl:w-auto ab 1280px -->
              <div class="relative aspect-video w-full xl:w-auto h-auto xl:h-full max-h-full max-w-full flex items-center justify-center bg-black rounded-xl overflow-hidden shadow-md border border-slate-200">

                <!-- Verschwommener Hintergrund für Hochformat-/schmale Bilder -->
                <Image
                  src={img.img}
                  alt=""
                  class="absolute inset-0 w-full h-full object-cover blur-xl opacity-40 pointer-events-none select-none scale-125"
                />

                <!-- Hauptbild -->
                <Image
                  src={img.img}
                  alt={img.title || img.themeTitle || "Galerie Bild"}
                  class="relative z-10 w-full h-full object-contain pointer-events-none select-none"
                />
              </div>
            </div>

            <!-- Titel & Bildbeschreibung -->
            <div class="w-full xl:w-80 xl:max-w-md shrink xl:min-w-48 flex flex-col justify-center text-left py-2 px-1 xl:px-3 max-h-[40%] xl:max-h-full overflow-y-auto">
              <!-- Thema dezent oben drüber -->
              {img.themeTitle && (
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
                {img.themeTitle}
              </span>
              )}

              <!-- Bildtitel als Hauptüberschrift -->
              <h3 class="text-lg xl:text-2xl font-bold text-slate-800 line-clamp-2">
                {img.title || img.themeTitle}
              </h3>

              <!-- Bildbeschreibung -->
              {(img.description) && (
                <p class="text-sm xl:text-base text-slate-600 mt-2 line-clamp-3 sm:line-clamp-4 xl:line-clamp-8">
                  {img.description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Feste Spalte Rechts: Button liegt außerhalb des Swipers -->
    <div class="shrink-0 flex items-center justify-center w-8 sm:w-10 h-full">
      <div class="swiper-button-next static! top-auto! left-auto! right-auto! mt-0! text-slate-700! hover:text-accent! after:text-lg! sm:after:text-xl! cursor-pointer"></div>
    </div>

  </div>

  <!-- Thumbs-Bereich: Dynamisch unter dem Bild ausgerichtet (Desktop) & clipping-frei auf Mobilgeräten -->
  <div class="w-full shrink-0 flex items-center justify-between gap-2 sm:gap-4 pb-3 sm:pb-5">

    <!-- Links: Spacer zur Ausrichtung mit der linken Nav-Spalte -->
    <div class="shrink-0 w-8 sm:w-10"></div>

    <!-- Mitte: Layout-Spiegelung analog zum Haupt-Swiper -->
    <div class="flex-1 min-w-0 flex flex-col xl:flex-row gap-4 xl:gap-8 items-center">

      <!-- Thumbs Swiper Container (Auf Desktop exakt unter der 16:9 Image Card, mobil volle verfügbare Breite) -->
      <div class="w-full xl:flex-1 min-w-0 flex items-center overflow-hidden">
        <div class="swiper thumbs-swiper w-full h-16 sm:h-20 select-none">
          <!-- WICHTIG: Kein 'justify-center' am swiper-wrapper, damit Swipers 'translate3d' aktive Thumbs mobil nicht abschneidet -->
          <div class="swiper-wrapper items-center">
            {allImages.map((image) => (
              <div class="swiper-slide w-16! sm:w-20! h-12! sm:h-16! cursor-pointer rounded-xl overflow-hidden shrink-0 border-2 border-transparent transition-all duration-200 shadow-xs">
                <Image
                  src={image.img}
                  alt={image.title || "Vorschau"}
                  class="h-full w-full object-cover cursor-pointer select-none"
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Desktop-Platzhalter: Spiegelt exakt die Flex-Breite der Textbox im Hauptbereich wider -->
      <div class="hidden xl:block xl:w-80 xl:max-w-md xl:min-w-48 shrink pointer-events-none"></div>

    </div>

    <!-- Rechts: Spacer zur Ausrichtung mit der rechten Nav-Spalte -->
    <div class="shrink-0 w-8 sm:w-10"></div>

  </div>
</div>

<style>
  .thumbs-swiper .swiper-slide {
    opacity: 0.4;
  }
  .thumbs-swiper .swiper-slide-thumb-active {
    opacity: 1 !important;
    border-color: var(--color-accent, #3b82f6) !important;
  }

  .bar {
    display: block;
    width: 26px;
    height: 3px;
    margin: 4px auto;
    background-color: currentColor;
    border-radius: 4px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .thumbs-swiper .swiper-slide {
    opacity: 0.4;
  }
  .thumbs-swiper .swiper-slide:hover {
    opacity: 0.75;
  }
  .thumbs-swiper .swiper-slide-thumb-active {
    opacity: 1 !important;
    border-color: var(--color-accent, #3b82f6) !important;
    transform: scale(1.05);
  }

  .close-btn .bar:nth-of-type(1) {
    transform: translateY(7px) rotate(-45deg);
  }
  .close-btn .bar:nth-of-type(2) {
    opacity: 0;
  }
  .close-btn .bar:nth-of-type(3) {
    transform: translateY(-7px) rotate(45deg);
  }

  .close-btn:hover .bar:nth-of-type(1) {
    transform: translateY(6px) rotate(-40.5deg);
  }
  .close-btn:hover .bar:nth-of-type(3) {
    transform: translateY(-6px) rotate(40.5deg);
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Thumbs, FreeMode } from 'swiper/modules';

  function initModalSwiper() {
    const modal = document.getElementById('theme-modal') as HTMLElement | null;
    const closeBtn = document.getElementById('modal-close-btn');
    const themeTitleEl = document.getElementById('modal-theme-title');
    const imageTitleEl = document.getElementById('modal-image-title');

    if (!modal) return;

    // Direct Elements
    const mainSwiperEl = modal.querySelector('.main-swiper') as HTMLElement | null;
    const thumbsSwiperEl = modal.querySelector('.thumbs-swiper') as HTMLElement | null;
    const nextEl = modal.querySelector('.swiper-button-next') as HTMLElement | null;
    const prevEl = modal.querySelector('.swiper-button-prev') as HTMLElement | null;

    if (!mainSwiperEl || !thumbsSwiperEl) return;

    // 1. Thumbs Swiper
    const thumbsSwiper = new Swiper(thumbsSwiperEl, {
      modules: [FreeMode],
      slidesPerView: 'auto',
      spaceBetween: 12,
      centeredSlides: true,
      slideToClickedSlide: true,
      watchSlidesProgress: true,
    });

    // 2. Haupt-Swiper
    const mainSwiper = new Swiper(mainSwiperEl, {
      modules: [Navigation, Thumbs],
      spaceBetween: 20,
      navigation: {
        nextEl: nextEl,
        prevEl: prevEl,
      },
      thumbs: {
        swiper: thumbsSwiper,
      },
      on: {
        slideChange: (swiper) => {
          updateHeaderInfo(swiper.activeIndex);
          thumbsSwiper.slideTo(swiper.activeIndex);
        },
      },
    });

    function updateHeaderInfo(index: number) {
      const activeSlide = mainSwiper.slides[index];
      if (activeSlide && themeTitleEl && imageTitleEl) {
        themeTitleEl.textContent = activeSlide.dataset.themeTitle || '';
        imageTitleEl.textContent = activeSlide.dataset.imageTitle || '';
      }
    }

    function openModal(index: number) {
      const galleryEl = document.getElementById('theme-gallery-view');
      if (galleryEl) {
        galleryEl.style.display = 'none';
      }

      modal!.style.display = 'flex';
      modal!.setAttribute('aria-hidden', 'false');

      mainSwiper.update();
      thumbsSwiper.update();

      mainSwiper.slideTo(index, 0);
      thumbsSwiper.slideTo(index, 0);
      updateHeaderInfo(index);
    }

    function closeModal() {
      modal!.style.display = 'none';
      modal!.setAttribute('aria-hidden', 'true');

      const galleryEl = document.getElementById('theme-gallery-view');
      if (galleryEl) {
        galleryEl.style.display = '';
      }

      const activeSlide = mainSwiper.slides[mainSwiper.activeIndex];
      if (activeSlide) {
        const themeId = activeSlide.dataset.themeId;
        if (themeId) {
          const detailsEl = document.getElementById(themeId) as HTMLDetailsElement | null;
          if (detailsEl) {
            detailsEl.open = true;
            detailsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }
    }

    function jumpToTheme(themeId: string) {
      // Sicherheitsabfrage: Wenn das Modal zu ist, machen wir gar nichts!
      if (!modal || modal.style.display === 'none') return;

      const slides = Array.from(mainSwiper.slides);
      const targetIndex = slides.findIndex(
        (slide) => slide.dataset.themeId === themeId
      );

      if (targetIndex !== -1) {
        // Slider im Modal zum ersten Bild des Themas bewegen
        mainSwiper.slideTo(targetIndex);
        thumbsSwiper.slideTo(targetIndex);
        updateHeaderInfo(targetIndex);
      }
    }

    // Hört auf Sidebar-Klicks, wenn das Modal bereits offen ist
    window.addEventListener('open-theme-modal', (e: Event) => {
      const customEvent = e as CustomEvent<{ themeId: string }>;
      if (customEvent.detail?.themeId) {
        jumpToTheme(customEvent.detail.themeId);
      }
    });

    // Event Delegation für Galerie- und Titel-Klicks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const card = target.closest('.gallery-image-card') as HTMLElement;
      if (card && card.dataset.globalIndex !== undefined) {
        openModal(parseInt(card.dataset.globalIndex, 10));
        return;
      }

      const titleTrigger = target.closest('.theme-title-trigger') as HTMLElement;
      if (titleTrigger && titleTrigger.dataset.startIndex !== undefined) {
        openModal(parseInt(titleTrigger.dataset.startIndex, 10));
        return;
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal!.style.display !== 'none') {
        closeModal();
      }
    });
  }

  initModalSwiper();
  document.addEventListener('astro:page-load', initModalSwiper);
</script>