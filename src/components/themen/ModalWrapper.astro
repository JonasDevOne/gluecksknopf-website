---
interface Props {
  id: string;
  closeBtnId: string;
  ariaLabel?: string;
}

const { id, closeBtnId, ariaLabel = "Modal" } = Astro.props;
---

<div
  id={id}
  style="display: none;"
  class="relative w-full h-full flex flex-col justify-between overflow-visible lg:overflow-hidden max-h-[calc(100vh-8rem)] rounded-2xl border border-slate-500 bg-white"
  aria-hidden="true"
  aria-label={ariaLabel}
>
  <button
    id={closeBtnId}
    type="button"
    class="close-btn absolute top-0 -right-14 lg:top-3 lg:right-3 z-40 p-2.5 rounded-xl bg-slate-600 text-white hover:text-accent cursor-pointer transition-all duration-300 shadow-md border border-slate-200"
    aria-label="Modal schließen"
  >
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <slot />
</div>

<style>
  .bar {
    display: block;
    width: 26px;
    height: 3px;
    margin: 4px auto;
    background-color: currentColor;
    border-radius: 4px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .close-btn .bar:nth-of-type(1) {
    transform: translateY(7px) rotate(-45deg);
  }
  .close-btn .bar:nth-of-type(2) {
    opacity: 0;
  }
  .close-btn .bar:nth-of-type(3) {
    transform: translateY(-7px) rotate(45deg);
  }

  .close-btn:hover .bar:nth-of-type(1) {
    transform: translateY(6px) rotate(-40.5deg);
  }
  .close-btn:hover .bar:nth-of-type(3) {
    transform: translateY(-6px) rotate(40.5deg);
  }
</style>