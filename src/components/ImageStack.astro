---
// src/components/ImageStack.astro
import { Image } from "astro:assets";

interface Props {
  stack: any;
  isEager?: boolean;
  globalIndex?: number;
}

const { stack, isEager = false, globalIndex } = Astro.props;

const stackImages = stack.resolvedImages || [];
const coverImage = stackImages[0]?.data.coverImage;
const imageCount = stackImages.length;

// Vorbereiten der Bilddaten (Extrahiert sicher die URL-String-Eigenschaft)
const stackData = {
  title: stack.data.title,
  themeTitle: stack.data.theme,
  images: stackImages.map((img: any) => {
    const rawCover = img.data.coverImage;
    const src = typeof rawCover === "string" ? rawCover : rawCover?.src || "";
    return {
      title: img.data.title || "",
      description: img.data.description || "",
      src: src,
    };
  }),
};
---

<div
  class="gallery-image-stack group/card relative aspect-video cursor-pointer select-none"
  data-global-index={globalIndex}
  data-stack-data={JSON.stringify(stackData)}
>
  <!-- Hintere Stapel-Ebenen -->
  <div class="absolute inset-0 translate-x-1.5 -translate-y-1.5 rounded-xl bg-slate-800 border border-slate-700/50 transition-transform duration-300 group-hover/card:translate-x-2.5 group-hover/card:-translate-y-2.5 opacity-60"></div>
  <div class="absolute inset-0 translate-x-0.75 -translate-y-0.75 rounded-xl bg-slate-900 border border-slate-700/50 transition-transform duration-300 group-hover/card:translate-x-1.25 group-hover/card:-translate-y-1.25 opacity-80"></div>

  <!-- Hauptkarte -->
  <div class="relative w-full h-full rounded-xl bg-black overflow-hidden flex items-center justify-center shadow-sm border border-slate-800/80">
    {coverImage && (
      <Image
        src={coverImage}
        alt={stack.data.title}
        class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover/card:scale-105"
        loading={isEager ? "eager" : "lazy"}
      />
    )}

    <!-- Stapel-Badge -->
    <div class="absolute top-2 right-2 z-10 flex items-center gap-1 rounded-md bg-black/70 px-2 py-0.5 text-[11px] font-medium text-white/90 backdrop-blur-xs border border-white/10 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
        <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7z" />
        <path d="M4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z" />
        <path fill-rule="evenodd" d="M2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4zm2 0h12v4H4v-4z" clip-rule="evenodd" />
      </svg>
      <span>{imageCount}</span>
    </div>

    <!-- Titel-Overlay -->
    <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 pointer-events-none flex items-end p-2.5">
      <p class="text-xs font-medium text-white line-clamp-1 drop-shadow-sm">
        {stack.data.title}
      </p>
    </div>
  </div>
</div>