---
import { getCollection } from "astro:content";
import Section from "@/layouts/Section.astro";
import SectionHeader from "@/components/SectionHeader.astro";

const fragen = await getCollection("fragenCollection");
fragen.sort((a, b) => a.data.order - b.data.order);
---

<Section label="FAQ Section" class="max-w-[95vw] mx-auto my-5">
  <SectionHeader title="FAQ" />

  <div class="mt-8 flex flex-col gap-4 max-w-4xl">
    {
      fragen.map((frage) => (
        <details class="group rounded-2xl border border-slate-200 dark:border-slate-800 p-5 transition-all">
          <summary class="flex cursor-pointer items-center justify-between list-none select-none focus:outline-none text-base md:text-lg font-semibold transition-colors">
            <span class="hover:text-accent">{frage.data.title}</span>
            <div class="toggle-btn flex h-9 w-9 items-center justify-center cursor-pointer hover:bg-accent rounded-xl transition-transform duration-300 group-open:rotate-180">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="h-6 w-6"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </summary>
          <div class="mt-3 text-sm md:text-base leading-relaxed">
            {frage.data.description}
          </div>
        </details>
      ))
    }
  </div>
</Section>