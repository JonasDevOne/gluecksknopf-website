---
import { getCollection } from 'astro:content';
import LinkButton from "../LinkButton.astro";
import Section from "../../layouts/Section.astro";
import SwiperCarousel from "@/components/SwiperCarousel.astro";
import ImageCard from "@/components/ImageCard.astro";

const allImages = await getCollection('imageCollection');

const carouselItems = allImages
  .filter(item => !item.data.hideInCarousel)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Section label="Galerie Section" class="max-w-[95vw] mx-auto my-5">
  <LinkButton link="/galerie">Galerie</LinkButton>
  <SwiperCarousel slidesPerViewMobile={1} slidesPerViewTablet={3} slidesPerViewDesktop={4} autoplay={true}>
    {carouselItems.map((item) => (
      <div class="swiper-slide">
        <ImageCard
          image={item}
        />
      </div>
    ))}
  </SwiperCarousel>
</Section>