---
import {Image} from "astro:assets";
import myLogo from "@/assets/logo.png";
import facebook from "@/assets/facebook.svg"
import instagram from "@/assets/instagram.svg"
import whatsApp from "@/assets/whatsApp.svg"
import email from "@/assets/email.svg"
import Section from "../../layouts/Section.astro";

const links = [
  {
    title : "FB",
    icon : facebook,
    href : "https://www.facebook.com/Gluecksknopf"
  },
  {
    title : "IG",
    icon : instagram,
    href : "https://instagram.com/gluecks.knopf"
  },
  {
    title : "WA",
    icon : whatsApp,
    href : "https://wa.me/491704874221"
  },
  {
    title : "E-MAIL",
    icon : email,
    href : "mailto:kerstin-gluecksknopf@outlook.de"
  }
];
---

<Section label="Hero Section" class="mt-section">
  <div class="flex flex-col items-center gap-space-md">
    <Image src={myLogo} alt="Logo" class="size-icon-xl" loading="eager"/>
    <ul class="flex justify-center items-center gap-space-xs">
      {links.map((i) => (
        <li>
          <a
            href={i.href}
            target="_blank"
            class="hover:opacity-80 hover:scale-105 inline-flex items-center justify-center p-1"
          >
            <Image
              src={i.icon}
              alt={i.title}
              class="size-icon-md aspect-square object-contain"
              loading="eager"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>