---
import Section from "../../layouts/Section.astro";
import LinkButton from "../LinkButton.astro";

import { getCollection } from 'astro:content';
import SwiperCarousel from "@/components/SwiperCarousel.astro";
import ThemeCard from "@/components/ThemeCard.astro";

const themen = await getCollection('themeCollection');
themen.sort((a, b) => a.data.order - b.data.order);
---

<Section label="Theme Section" class="max-w-[95vw] mx-auto my-5">
  <LinkButton link="/themen">Themenwelten</LinkButton>
  <SwiperCarousel slidesPerViewMobile={3} slidesPerViewTablet={3} slidesPerViewDesktop={5}>
    {themen.map((thema) =>(
      <ThemeCard
        img={thema.data.img}
        alt={thema.data.alt}
        title={thema.data.title}
        text={thema.data.text}
        id={thema.id}
      />
    ))}
  </SwiperCarousel>
</Section>