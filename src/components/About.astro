---
import Section from "@/layouts/Section.astro";
import {baseData} from "@/data/siteData";

const limit = 25;
const text = baseData.about;
const words = text.trim().split(/\s+/);
const isLong = words.length > limit;

// Erzeuge gekürzten Text
const truncatedText = isLong ? words.slice(0, limit).join(' ') + '...' : text;
---


<Section label="About" class="flex flex-col items-center content-center max-w-[70vw] mx-auto gap-3 my-5">
  <h2 class="mb-5 px-3 py-2 font-bold text-2xl border-2 border-current">Über mich</h2>
  <div class="word-limit-container">
    {isLong ? (
      <p class="leading-relaxed">
        <span class="short-text">{truncatedText}</span>
        <span class="full-text hidden">{text}</span>
        <button
          class="toggle-btn ml-1 font-semibold text-accent hover:underline cursor-pointer text-lg opacity-70"
        >
          Mehr anzeigen
        </button>
      </p>
    ) : (
      <p class="leading-relaxed">{text}</p>
    )}
  </div>
</Section>

<script>
  document.querySelectorAll('.word-limit-container').forEach((container) => {
    const btn = container.querySelector('.toggle-btn');
    const shortText = container.querySelector('.short-text');
    const fullText = container.querySelector('.full-text');

    btn?.addEventListener('click', () => {
      const isExpanded = !fullText?.classList.contains('hidden');

      if (isExpanded) {
        shortText?.classList.remove('hidden');
        fullText?.classList.add('hidden');
        btn.textContent = 'Mehr anzeigen';
      } else {
        shortText?.classList.add('hidden');
        fullText?.classList.remove('hidden');
        btn.textContent = 'Weniger anzeigen';
      }
    });
  });
</script>