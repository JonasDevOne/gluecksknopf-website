---
import Section from "@/layouts/Section.astro";
import {baseData} from "@/data/siteData";

const lines = 3;
const text = baseData.about;
---

<Section label="About" class="flex flex-col items-center content-center max-w-[70vw] mx-auto gap-3 my-5">
  <h2 class="mb-5 px-3 py-2 font-bold text-2xl border-2 border-current">Über mich</h2>
    <div class="expandable-text group">
      <p class={`text-content line-clamp-${lines} transition-all duration-300 ease-in-out`}>
          {text}
      </p>
      <button class="toggle-btn text-base font-semibold text-accent hover:text-accent-800 hover:underline cursor-pointer transition-colors" aria-expanded="false"
      >
        Mehr anzeigen
      </button>
    </div>
</Section>

<script>
    function setupExpandableText() {
        const containers = document.querySelectorAll('.expandable-text');

        containers.forEach((container) => {
            const textEl = container.querySelector('.text-content');
            const btn = container.querySelector('.toggle-btn') as HTMLButtonElement;

            if (!textEl || !btn) return;

            // Prüfen, ob der Text überhaupt abgeschnitten wird
            const isOverflowing = textEl.scrollHeight > textEl.clientHeight;

            // Falls der Text kurz genug ist, Button ausblenden
            if (!isOverflowing) {
                btn.style.display = 'none';
                return;
            }

            btn.addEventListener('click', () => {
                const isClamped = textEl.classList.contains('line-clamp-3'); // bzw. deine Standardzeilenzahl

                if (isClamped) {
                    // Alle line-clamp-Klassen entfernen, um vollen Text anzuzeigen
                    textEl.className = textEl.className.replace(/line-clamp-\d+/, '');
                    btn.textContent = 'Weniger anzeigen';
                    btn.setAttribute('aria-expanded', 'true');
                } else {
                    // Wieder einkappen
                    textEl.classList.add('line-clamp-3');
                    btn.textContent = 'Mehr anzeigen';
                    btn.setAttribute('aria-expanded', 'false');
                }
            });
        });
    }

    // Initial ausführen
    setupExpandableText();
</script>