---
import {Image} from "astro:assets";
import myLogo from "@/assets/logo.png";
import facebook from "@/assets/facebook.svg"
import instagram from "@/assets/instagram.svg"
import whatsApp from "@/assets/whatsApp.svg"
import Section from "../layouts/Section.astro";

const links = [
  {
    title : "FB",
    icon : facebook,
    href : "https://www.facebook.com/Gluecksknopf"
  },
  {
    title : "IG",
    icon : instagram,
    href : "https://instagram.com/gluecks.knopf"
  },
  {
    title : "WA",
    icon : whatsApp,
    href : "https://wa.me/491704874221"
  }
];
---

<Section label="Hero Section">
  <div class="flex flex-col items-center gap-space-md mb-section">
    <Image src={myLogo} alt="Logo" class="size-icon-xl" />
    <ul class="flex justify-center gap-space-xs">
      {links.map((i) => (
        <li>
          <a href={i.href} target="_blank" class="hover:opacity-80 hover:scale-105 block p-1">
            <Image src={i.icon} alt={i.title} class="size-icon-md w-auto" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>