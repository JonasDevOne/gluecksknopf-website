---
import BaseLayout from "../layouts/BaseLayout.astro";
import SidebarNav from "@/components/SidebarNav.astro";
import ThemeGalleryView from "@/components/themen/ThemeGalleryView.astro";
import ThemeModalView from "@/components/themen/ThemeModalView.astro";
import { getCollection } from "astro:content";

const themen = await getCollection('themeCollection');
const images = await getCollection('imageCollection');
const imageStacks = await getCollection('imageStackCollection');

// Alle Galerie-Elemente (Einzelbilder und Bilderstapel) zusammenführen
const allGalleryItems = [...images, ...imageStacks];

// Themen selbst nach ihrer Order sortieren (höchste Order zuerst)
themen.sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const navItems = themen.map((item) => ({
  title: item.data.title,
  href: `#${item.id}`,
}));

let globalItemCount = 0;

const themesWithImages = themen.map((thema) => {
  // Elemente des aktuellen Themas filtern und gemeinsam sortieren
  const themeItems = allGalleryItems
    .filter((item) => item.data.theme === thema.data.title)
    .sort((a, b) => {
      const orderA = a.data.order ?? 0;
      const orderB = b.data.order ?? 0;

      // Zuerst nach 'order' sortieren (höchste Zahl zuerst)
      if (orderA !== orderB) {
        return orderB - orderA;
      }

      // Bei gleicher Order nach Datum sortieren (neuestes zuerst)
      return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
    });

  const startIndex = globalItemCount;
  globalItemCount += themeItems.length;

  return {
    thema,
    images: themeItems, // Enthält jetzt gemischt ImageCards und ImageStacks
    startIndex,
  };
});

// allModalImages übernimmt automatisch die sortierte Reihenfolge aus themesWithImages
const allModalImages = themesWithImages.flatMap(({ thema, images }) =>
  images.map((item) => {
    // TypeScript verfeinert den Typen automatisch im jeweiligen Zweig:
    if ("images" in item.data) {
      // Ist ein Bilderstapel (ImageStack)
      return {
        title: item.data.title,
        description: item.data.images[0]?.description,
        themeTitle: thema.data.title,
        themeId: thema.id,
        img: item.data.images[0]?.img,
      };
    } else {
      // Ist eine Einzelbild-Karte (ImageCard)
      return {
        title: item.data.title,
        description: item.data.description,
        themeTitle: thema.data.title,
        themeId: thema.id,
        img: item.data.coverImage,
      };
    }
  })
);
---

<BaseLayout>
  <SidebarNav items={navItems}>
    <div id="view-container" data-active-view="gallery" class="relative w-full h-full">

      <div id="theme-gallery-view-wrapper" class="w-full">
        <ThemeGalleryView themenWithImages={themesWithImages} />
      </div>

      <ThemeModalView allImages={allModalImages} />

    </div>
  </SidebarNav>
</BaseLayout>