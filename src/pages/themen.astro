---
import BaseLayout from "../layouts/BaseLayout.astro";
import SidebarNav from "@/components/SidebarNav.astro";
import ThemeGalleryView from "@/components/ThemeGalleryView.astro";
import { getCollection } from "astro:content";

// 1. Collections laden
const themen = await getCollection('themeCollection');
const images = await getCollection('imageCollection');

// 2. Sortieren
themen.sort((a, b) => a.data.order - b.data.order);

// 3. Navigation-Items erzeugen
const navItems = themen.map((item) => ({
  title: item.data.title,
  href: `#${item.id}`,
}));

// 4. Themen direkt mit ihren passenden Bildern verknüpfen (verhindert Filter-Logik im Template)
const themenWithImages = themen.map((thema) => ({
  thema,
  images: images.filter((img) => img.data.theme === thema.data.title),
}));
---

<BaseLayout>
  <SidebarNav items={navItems}>
    <ThemeGalleryView themenWithImages={themenWithImages} />
  </SidebarNav>
</BaseLayout>