---
import BaseLayout from "../layouts/BaseLayout.astro";
import SidebarNav from "@/components/SidebarNav.astro";
import ThemeGalleryView from "@/components/themen/ThemeGalleryView.astro";
import ThemeModalView from "@/components/themen/ThemeModalView.astro";
import { getCollection } from "astro:content";

const themen = await getCollection('themeCollection');
const images = await getCollection('imageCollection');

// Themen selbst nach ihrer Order sortieren
themen.sort((a, b) => b.data.order - a.data.order);

const navItems = themen.map((item) => ({
  title: item.data.title,
  href: `#${item.id}`,
}));

let globalImageCount = 0;

const themesWithImages = themen.map((thema) => {
  // 1. Bilder des aktuellen Themas filtern und nach der neuen Logik sortieren
  const themeImages = images
    .filter((img) => img.data.theme === thema.data.title)
    .sort((a, b) => {
      const orderA = a.data.order ?? 0;
      const orderB = b.data.order ?? 0;

      // Zuerst nach 'order' sortieren (höchste Zahl zuerst)
      if (orderA !== orderB) {
        return orderB - orderA;
      }

      // Bei gleicher Order (z. B. beide 0) nach Datum sortieren (neuestes zuerst)
      return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
    });

  const startIndex = globalImageCount;
  globalImageCount += themeImages.length;

  return {
    thema,
    images: themeImages,
    startIndex,
  };
});

// allModalImages übernimmt automatisch die sortierte Reihenfolge aus themesWithImages
const allModalImages = themesWithImages.flatMap(({ thema, images }) =>
  images.map((img) => ({
    title: img.data.title,
    description: img.data.description,
    themeTitle: thema.data.title,
    themeId: thema.id,
    img: img.data.coverImage,
    order: img.data.order,
    publishDate: img.data.publishDate,
  }))
);
---

<BaseLayout>
  <SidebarNav items={navItems}>
    <div id="view-container" data-active-view="gallery" class="relative w-full h-full">

      <div id="theme-gallery-view" class="w-full">
        <ThemeGalleryView themenWithImages={themesWithImages} />
      </div>

      <ThemeModalView allImages={allModalImages} />

    </div>
  </SidebarNav>
</BaseLayout>