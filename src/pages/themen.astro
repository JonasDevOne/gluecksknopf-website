---
// src/pages/themen.astro
import StackModalView from "@/components/themen/StackModalView.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SidebarNav from "@/components/SidebarNav.astro";
import ThemeGalleryView from "@/components/themen/ThemeGalleryView.astro";
import ThemeModalView from "@/components/themen/ThemeModalView.astro";
import { getCollection } from "astro:content";

const themen = await getCollection('themeCollection');
const allImages = await getCollection('imageCollection');
const imageStacks = await getCollection('imageStackCollection');

// 1. Alle Bild-IDs ermitteln, die in IRGENDEINEM Stapel vorkommen
const idsInStacks = new Set(
  imageStacks.flatMap((stack) => stack.data.images)
);

// 2. Einzelbilder filtern: Nur anzeigen, wenn hideStandalone: false UND nicht Teil eines Stapels
const standaloneImages = allImages.filter((img) => {
  const isExplicitlyHidden = img.data.hide === true;
  const isUsedInStack = idsInStacks.has(img.id) || idsInStacks.has(img.id.replace(/\.md$/, ''));
  return !isExplicitlyHidden && !isUsedInStack;
});

// 3. Stacks mit den echten Image-Objekten aus allImages verknüpfen
const resolvedStacks = imageStacks.map((stack) => {
  const stackImageObjects = stack.data.images
    .map((imgInStack) =>
      allImages.find((img) => img.data.title === imgInStack)
    )
    .filter((img): img is NonNullable<typeof img> => img !== undefined);

  return {
    ...stack,
    resolvedImages: stackImageObjects, // Enthält jetzt die vollständigen Bild-Objekte aus bilderDefinition
  };
});

// 4. Standalone-Bilder und aufgelöste Stacks zusammenführen
const allGalleryItems = [...standaloneImages, ...resolvedStacks];

// Themen sortieren
themen.sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const navItems = themen.map((item) => ({
  title: item.data.title,
  href: `#${item.id}`,
}));

let globalItemCount = 0;

const themesWithImages = themen.map((thema) => {
  const themeItems = allGalleryItems
    .filter((item) => item.data.theme === thema.data.title)
    .sort((a, b) => {
      const orderA = a.data.order ?? 0;
      const orderB = b.data.order ?? 0;

      if (orderA !== orderB) {
        return orderB - orderA;
      }
      return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
    });

  const startIndex = globalItemCount;
  globalItemCount += themeItems.length;

  return {
    thema,
    images: themeItems,
    startIndex,
  };
});

// Modal-Vorbereitung (greift sicher auf das Cover-Bild zu)
const allModalImages = themesWithImages.flatMap(({ thema, images }) =>
  images.map((item) => {
    const isStack = "resolvedImages" in item;
    const stackImages = isStack ? item.resolvedImages : [];

    const coverImg = isStack
      ? stackImages[0]?.data.coverImage
      : item.data.coverImage;

    const description = isStack
      ? stackImages[0]?.data.description
      : item.data.description;

    const stackData = isStack
      ? {
        title: item.data.title,
        themeTitle: thema.data.title,
        images: stackImages.map((img: any) => ({
          title: img.data.title || "",
          description: img.data.description || "",
          src: typeof img.data.coverImage === "string" ? img.data.coverImage : img.data.coverImage?.src || "",
        })),
      }
      : null;

    return {
      title: item.data.title,
      description,
      themeTitle: thema.data.title,
      themeId: thema.id,
      img: coverImg,
      order: item.data.order,
      publishDate: item.data.publishDate,
      isStack,
      stackCount: isStack ? stackImages.length : 0,
      stackData,
    };
  })
);
---

<BaseLayout>
  <SidebarNav items={navItems}>
    <div id="view-container" data-active-view="gallery" class="relative w-full h-full">

      <!-- Galerie-Grid -->
      <div id="theme-gallery-view-wrapper" class="w-full">
        <ThemeGalleryView themenWithImages={themesWithImages} />
      </div>

      <!-- Galerie-Modal für Einzelbilder -->
      <ThemeModalView allImages={allModalImages} />

      <!-- Stapel-Modal für Bilderstapel -->
      <StackModalView />

    </div>
  </SidebarNav>
</BaseLayout>