    <p class="">
      &copy; {currentYear} Kerstin Knopf. Alle Rechte vorbehalten.
    </p>

    <nav aria-label="Rechtliche Hinweise">
      <ul class="flex items-center gap-6 font-medium">
        <li>
          <a
            href="/impressum"
            class="hover:underline"
          >
            Impressum
          </a>
        </li>
        <li>
          <a
            href="/datenschutz"
            class="hover:underline"
          >
            Datenschutz
          </a>
        </li>
      </ul>
    </nav>

  </div>
</footer>